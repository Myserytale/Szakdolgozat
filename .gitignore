# Ignore everything by default
/*

# Whitelist repository files & folders
!.gitignore
!README.md
!requirements.txt
!initial_edf_parsing/
!literature/
!pyeeg/

# Ignore Python caches everywhere
**/__pycache__/
**/*.py[cod]
.venv/

# Ignore raw backups and archives
archives/
*.zip

# Ignore large generated data outputs by default (keep source code clean)
outputs/spindles_csv/
initial_edf_parsing/spindles_csv/
initial_edf_parsing/*.csv
